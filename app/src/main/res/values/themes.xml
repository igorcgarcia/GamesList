<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.MarketdataSFMC" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/md_navy_800</item>
        <item name="colorPrimaryVariant">@color/md_navy_900</item>
        <item name="colorOnPrimary">@color/md_white</item>
        <item name="colorSecondary">@color/md_orange_500</item>
        <item name="colorSecondaryVariant">@color/md_orange_600</item>
        <item name="colorOnSecondary">@color/md_white</item>
        <item name="android:colorBackground">@color/md_gray_50</item>
        <item name="colorSurface">@color/md_white</item>
        <item name="colorOnSurface">@color/md_gray_900</item>
        <item name="colorError">@color/md_error</item>
        <item name="android:textColorPrimary">@color/md_gray_900</item>
        <item name="android:textColorSecondary">@color/md_gray_500</item>
        <item name="android:windowBackground">@color/md_gray_50</item>
        <item name="android:statusBarColor">@color/md_navy_900</item>
        <item name="android:navigationBarColor">@color/md_white</item>
        <item name="materialButtonStyle">@style/Widget.Marketdata.Button</item>
        <item name="bottomNavigationStyle">@style/Widget.Marketdata.BottomNavigation</item>
        <item name="cardViewStyle">@style/Widget.Marketdata.CardView</item>
    </style>

    <style name="Theme.MarketdataSFMC.Splash" parent="Theme.MarketdataSFMC">
        <item name="android:windowBackground">@color/md_navy_800</item>
        <item name="android:statusBarColor">@color/md_navy_900</item>
        <item name="android:navigationBarColor">@color/md_navy_800</item>
    </style>

    <!-- Buttons -->
    <style name="Widget.Marketdata.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/md_navy_800</item>
        <item name="android:textColor">@color/md_white</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
    </style>

    <style name="Widget.Marketdata.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/md_navy_800</item>
        <item name="android:textColor">@color/md_navy_800</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.Marketdata.Button.Accent" parent="Widget.Marketdata.Button">
        <item name="backgroundTint">@color/md_orange_500</item>
    </style>

    <style name="Widget.Marketdata.Button.Danger" parent="Widget.Marketdata.Button">
        <item name="backgroundTint">@color/md_error</item>
    </style>

    <!-- Card -->
    <style name="Widget.Marketdata.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardElevation">2dp</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="contentPadding">0dp</item>
        <item name="cardBackgroundColor">@color/md_white</item>
    </style>

    <!-- Bottom Navigation -->
    <style name="Widget.Marketdata.BottomNavigation" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="backgroundTint">@color/md_white</item>
        <item name="itemIconTint">@color/selector_bottom_nav</item>
        <item name="itemTextColor">@color/selector_bottom_nav</item>
        <item name="elevation">8dp</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <!-- TextInputLayout -->
    <style name="Widget.Marketdata.TextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/md_navy_300</item>
        <item name="hintTextColor">@color/md_navy_600</item>
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
    </style>

</resources>
